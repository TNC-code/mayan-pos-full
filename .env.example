# --- Database (PostgreSQL) ---
POSTGRES_DB=inventory_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
HOST=localhost
PORT=5432
DB_POOL_MAX=10
DB_SSL=false
DB_STATEMENT_TIMEOUT_MS=15000

# --- App ---
NODE_ENV=development
APP_PORT=3000
APP_BASE_PATH=/api/v1

# --- JWT (generate: openssl rand -hex 48) ---
JWT_SECRET=change-me-min-32-characters-long-secret
JWT_EXPIRES_IN=12h
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10

# --- Role fallback (utama: kolom user_account.role di DB) ---
OWNER_USERNAMES=owner
KASIR_USERNAMES=kasir1,kasir2

# --- Seed user ---
SEED_OWNER_PASSWORD=change-me
SEED_KASIR_PASSWORD=change-me

# --- Bisnis ---
BUSINESS_TZ=Asia/Jakarta

# --- Backup (opsional) ---
BACKUP_RETENTION_DAYS=14
